  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #f5f5f5;
}

/* Header Styling */
#headerWidget {
    background-color: #1B4332;
    border-bottom: 3px solid #C9A227;
}

#lblLogo {
    color: white;
}

#lblAppTitle {
    color: white;
    font-size: 32px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 3px;
}

#lblAppSubtitle {
    color: #C9A227;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 4px;
}

#lblOnlineStatus {
    color: #4CAF50;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
}

#lblVersion {
    background-color: #C9A227;
    color: white;
    font-size: 14px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 10px 18px;
    border-radius: 20px;
}

/* Tab Widget Styling */
QTabWidget::pane {
    border: 1px solid #ddd;
    background-color: white;
    border-radius: 0px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #f0f0f0;
    color: #444;
    padding: 10px 28px;
    margin-right: 2px;
    border: 1px solid #ddd;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QTabBar::tab:selected {
    background-color: white;
    color: #1B4332;
    font-weight: bold;
    font-size: 13px;
    border-bottom: 3px solid #1B4332;
}

QTabBar::tab:hover:!selected {
    background-color: #e8e8e8;
}

/* Group Box Styling */
QGroupBox {
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: white;
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 5px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    padding: 6px 15px;
    background-color: #1B4332;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

/* Input Field Styling */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    padding: 6px 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background-color: white;
    color: #333;
    font-size: 13px;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-height: 18px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #1B4332;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* Text Edit Styling */
QTextEdit, QTextBrowser {
    border: 1px solid #ddd;
    border-radius: 4px;
    background-color: white;
    color: #333;
    font-size: 14px;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 10px;
}

QTextEdit:focus, QTextBrowser:focus {
    border: 2px solid #1B4332;
}

/* Button Styling */
QPushButton {
    padding: 8px 18px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-width: 100px;
}

QPushButton#btnPlanifier, QPushButton#btnStart, QPushButton#btnValidateQuality, QPushButton#btnGenerateReport, QPushButton#btnUpdateMonitoring {
    background-color: #1B4332;
    color: white;
    border: none;
}

QPushButton#btnPlanifier:hover, QPushButton#btnStart:hover, QPushButton#btnValidateQuality:hover, QPushButton#btnGenerateReport:hover, QPushButton#btnUpdateMonitoring:hover {
    background-color: #2D5A45;
}

QPushButton#btnStop {
    background-color: #dc3545;
    color: white;
    border: none;
}

QPushButton#btnStop:hover {
    background-color: #c82333;
}

QPushButton#btnExportPDF {
    background-color: #C9A227;
    color: white;
    border: none;
}

QPushButton#btnExportPDF:hover {
    background-color: #B8911F;
}

/* Progress Bar Styling */
QProgressBar {
    border: 1px solid #ddd;
    border-radius: 4px;
    text-align: center;
    font-weight: bold;
    background-color: #f0f0f0;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: #1B4332;
    border-radius: 3px;
}

/* Table Styling */
QTableWidget {
    border: 1px solid #ddd;
    border-radius: 4px;
    background-color: white;
    gridline-color: #eee;
}

QTableWidget::item {
    padding: 8px;
}

QHeaderView::section {
    background-color: #1B4332;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
}

/* Label Styling */
QLabel {
    color: #333;
    font-size: 14px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Checkbox Styling */
QCheckBox {
    font-size: 14px;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #333;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:checked {
    background-color: #1B4332;
    border: 2px solid #1B4332;
    border-radius: 3px;
}

QCheckBox::indicator:unchecked {
    background-color: white;
    border: 2px solid #ddd;
    border-radius: 3px;
}

/* Status Labels */
#lblStatusPlanification, #lblCurrentStatus, #lblRunningProduction {
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 4px;
}

/* Footer Status */
#footerWidget {
    background-color: #f8f9fa;
    border-top: 1px solid #ddd;
}

/* Back Button */
#btnBackToMenu {
    background-color: #C9A227;
    color: white;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 16px;
    border-radius: 4px;
    border: none;
    min-width: 80px;
}

#btnBackToMenu:hover {
    background-color: #B8911F;
}

#btnBackToMenu:pressed {
    background-color: #9A7A1A;
}
