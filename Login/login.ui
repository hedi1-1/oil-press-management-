   <string notr="true">QMainWindow { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f0f2f5, stop:1 #e4e7eb); }
QLabel { color: #0f172a; }

QWidget#headerBarWidget { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1B4332, stop:1 #234E3E); }
QLabel#brandTitleLabel { color: #C9A227; font-weight: bold; }
QLabel#brandSubtitleLabel { color: #ffffff; }
QLabel#versionLabel { color: #4ADE80; }

QFrame#loginCardFrame { background: #ffffff; border: 2px solid #1B4332; border-radius: 16px; }
QLineEdit { border: 2px solid #234E3E; border-radius: 10px; padding: 11px 12px; background: #ffffff; color: #0f172a; }
QLineEdit:focus { border: 2px solid #C9A227; }

QPushButton#btnSuivant { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1B4332, stop:1 #234E3E); color: #ffffff; border: none; border-radius: 12px; padding: 12px 24px; font-weight: 600; font-size: 14px; }
QPushButton#btnSuivant:hover { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #234E3E, stop:1 #1B4332); }
QPushButton#btnSuivant:pressed { background: #0F2A1F; }

QPushButton#forgotPasswordButton { background: transparent; color: #1B4332; border: none; font-weight: 500; }
QPushButton#forgotPasswordButton:hover { color: #C9A227; text-decoration: underline; }

QCheckBox { color: #1f2937; spacing: 8px; }
QCheckBox::indicator:checked { background: #1B4332; border: 1px solid #1B4332; }
QLabel#loginSubtitleLabel { color: #234E3E; }
QLabel#securityInfoLabel { color: #234E3E; }
QLabel#loginStatusLabel { color: #C9A227; font-weight: bold; }</string>
