/* ═══════════════════════════════════════════════════════════════
   PRESSIQ - GESTION DES CLIENTS - PROFESSIONAL THEME
   Smart Oil Press Management System - Module Clients
═══════════════════════════════════════════════════════════════ */

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #f0f2f5, stop:1 #e4e7eb);
}

/* ─── HEADER ─── */
#headerWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #1B4332, stop:0.5 #234E3E, stop:1 #1B4332);
    border-bottom: 4px solid #C9A227;
}

#lblAppTitle {
    color: white;
    font-size: 28px;
    font-weight: 800;
    font-family: 'Segoe UI', 'Arial Black', sans-serif;
    letter-spacing: 2px;
}

#lblAppSubtitle {
    color: #C9A227;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 5px;
}

#lblDateTime {
    color: rgba(255, 255, 255, 0.9);
    font-size: 13px;
    font-weight: 500;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 20px;
}

#lblOnlineStatus {
    color: #4ADE80;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 6px 14px;
    background-color: rgba(74, 222, 128, 0.15);
    border-radius: 15px;
    border: 1px solid rgba(74, 222, 128, 0.3);
}

#btnBackToMenu {
    background-color: rgba(255, 255, 255, 0.15);
    color: white;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    min-width: 120px;
}

#btnBackToMenu:hover {
    background-color: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.5);
}

#btnBackToMenu:pressed {
    background-color: rgba(255, 255, 255, 0.1);
}

/* ─── STATISTICS CARDS ─── */
#statsWidget {
    background: transparent;
}

#statCardTotal, #statCardImportant, #statCardStandard, #statCardOlives {
    background: white;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    padding: 8px;
}

#statCardTotal:hover, #statCardImportant:hover, #statCardStandard:hover, #statCardOlives:hover {
    border: 1px solid #1B4332;
    background: #fafffe;
}

/* ─── TAB WIDGET ─── */
QTabWidget::pane {
    border: none;
    background-color: transparent;
    border-radius: 12px;
    margin-top: 0px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: white;
    color: #666;
    padding: 12px 28px;
    margin-right: 4px;
    border: none;
    border-radius: 8px 8px 0 0;
    font-size: 13px;
    font-weight: 600;
    min-width: 160px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QTabBar::tab:selected {
    background-color: #1B4332;
    color: white;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    background-color: #f0f0f0;
    color: #1B4332;
}

/* ─── GROUP BOXES ─── */
QGroupBox {
    font-weight: bold;
    border: 2px solid #1B4332;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 15px;
    background-color: white;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px;
    color: #1B4332;
    font-size: 14px;
    font-weight: 700;
}

/* ─── FORM INPUTS ─── */
QLineEdit {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px 12px;
    background: white;
    color: #2c3e50;
    font-size: 13px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QLineEdit:focus {
    border: 2px solid #1B4332;
    background: #fafffe;
}

QComboBox {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px 12px;
    background: white;
    color: #2c3e50;
    font-size: 13px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QComboBox:focus {
    border: 2px solid #1B4332;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QDateEdit {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 8px 12px;
    background: white;
    color: #2c3e50;
    font-size: 13px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QDateEdit:focus {
    border: 2px solid #1B4332;
}

/* ─── LABELS ─── */
QLabel {
    color: #2c3e50;
    font-size: 13px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* ─── TABLE WIDGET ─── */
QTableWidget, QTableView {
    background-color: white;
    alternate-background-color: #f8faf8;
    border: 1px solid #ddd;
    border-radius: 8px;
    gridline-color: #e8e8e8;
    font-size: 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
    selection-background-color: #1B4332;
    selection-color: white;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #1B4332, stop:1 #2D5A45);
    color: white;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    font-family: 'Segoe UI', Arial, sans-serif;
    border: none;
    border-right: 1px solid rgba(255,255,255,0.2);
}

/* ─── BUTTONS ─── */
QPushButton {
    background-color: #1B4332;
    color: white;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 18px;
    border-radius: 6px;
    border: none;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #2D5A45;
}

QPushButton:pressed {
    background-color: #143527;
}

QPushButton:disabled {
    background: #ccc;
    color: #888;
}

/* ─── TEXT EDITS ─── */
QTextEdit {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #333;
}

/* ─── FOOTER ─── */
#footerWidget {
    background-color: #1B4332;
    border-top: 3px solid #C9A227;
}

#lblFooter {
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    font-weight: 400;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 0.5px;
}

