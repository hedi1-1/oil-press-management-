/* ═══════════════════════════════════════════════════════════════
   PRESSIQ - MODERN PROFESSIONAL THEME
   Smart Oil Press Management System v2.0
═══════════════════════════════════════════════════════════════ */

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #f8f9fa, stop:0.5 #e9ecef, stop:1 #f8f9fa);
}

/* ─────────────────────────────────────────────────────────────────
   HEADER SECTION
───────────────────────────────────────────────────────────────── */
#headerWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                stop:0 #1B4332, stop:0.5 #2D5A45, stop:1 #1B4332);
    border-bottom: 4px solid #C9A227;
}

#lblAppTitle {
    color: white;
    font-size: 36px;
    font-weight: 800;
    font-family: 'Segoe UI', 'Arial Black', sans-serif;
    letter-spacing: 2px;
}

#lblAppSubtitle {
    color: #C9A227;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 6px;
}

#lblDateTime {
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    font-weight: 500;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 20px;
}

#lblOnlineStatus {
    color: #4ADE80;
    font-size: 14px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 16px;
    background-color: rgba(74, 222, 128, 0.15);
    border-radius: 20px;
    border: 1px solid rgba(74, 222, 128, 0.3);
}

/* ─────────────────────────────────────────────────────────────────
   WELCOME SECTION
───────────────────────────────────────────────────────────────── */
#welcomeWidget {
    background-color: white;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
}

#lblWelcome {
    color: #1B4332;
    font-size: 28px;
    font-weight: 700;
    font-family: 'Segoe UI', Arial, sans-serif;
}

#lblWelcomeDesc {
    color: #6c757d;
    font-size: 15px;
    font-family: 'Segoe UI', Arial, sans-serif;
    line-height: 1.6;
}

/* ─────────────────────────────────────────────────────────────────
   STATISTICS CARDS
───────────────────────────────────────────────────────────────── */
#statsWidget {
    background: transparent;
}

#statCard1, #statCard2, #statCard3, #statCard4 {
    background: white;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    padding: 15px;
}

#statCard1:hover, #statCard2:hover, #statCard3:hover, #statCard4:hover {
    border: 1px solid #1B4332;
}

/* ─────────────────────────────────────────────────────────────────
   MODULE CARDS - MODERN DESIGN
───────────────────────────────────────────────────────────────── */
#contentWidget {
    background: transparent;
}

/* Module Card Base Style */
QPushButton#btnClientManagement,
QPushButton#btnUserStaffManagement,
QPushButton#btnStockManagement,
QPushButton#btnProductionManagement,
QPushButton#btnFinanceManagement,
QPushButton#btnMachineAlertManagement {
    background-color: white;
    color: #333;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    padding: 18px 15px;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-height: 80px;
    min-width: 260px;
    text-align: left;
}

QPushButton#btnClientManagement:hover,
QPushButton#btnUserStaffManagement:hover,
QPushButton#btnStockManagement:hover,
QPushButton#btnProductionManagement:hover,
QPushButton#btnFinanceManagement:hover,
QPushButton#btnMachineAlertManagement:hover {
    background-color: #f8fff8;
    border: 2px solid #1B4332;
    color: #1B4332;
}

QPushButton#btnClientManagement:pressed,
QPushButton#btnUserStaffManagement:pressed,
QPushButton#btnStockManagement:pressed,
QPushButton#btnProductionManagement:pressed,
QPushButton#btnFinanceManagement:pressed,
QPushButton#btnMachineAlertManagement:pressed {
    background-color: #1B4332;
    color: white;
}

/* Special styling for active modules */
QPushButton#btnProductionManagement,
QPushButton#btnMachineAlertManagement {
    border-left: 5px solid #4ADE80;
}

/* Styling for coming soon modules */
QPushButton#btnClientManagement,
QPushButton#btnUserStaffManagement,
QPushButton#btnStockManagement,
QPushButton#btnFinanceManagement {
    border-left: 5px solid #C9A227;
}

/* ─────────────────────────────────────────────────────────────────
   FOOTER SECTION - MODERN PREMIUM DESIGN
───────────────────────────────────────────────────────────────── */
#footerWidget {
    background-color: #1B4332;
    border-top: 4px solid #D4A017;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

#lblFooter {
    color: rgba(255, 255, 255, 0.95);
    font-size: 13px;
    font-weight: 400;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 0.5px;
}

#lblVersion {
    color: transparent;
    font-size: 0px;
}

/* ─────────────────────────────────────────────────────────────────
   GENERAL LABELS
───────────────────────────────────────────────────────────────── */
QLabel {
    color: #333;
    font-family: 'Segoe UI', Arial, sans-serif;
}

