  <property name="styleSheet">
   <string>
QMainWindow { background-color: #f3f6f5; font-family: Segoe UI, Helvetica, Arial, sans-serif; font-size: 11px; }
#centralwidget { background-color: #f3f6f5; }
QLabel { color:#111827; }

/* HEADER */
#frameHeader { background-color: #2c3e2e; min-height: 50px; }
#labelLogo { color: white; font-size: 20px; font-weight: bold; }
#labelSubtitle { color: #d4a63a; font-size: 10px; font-weight: 600; }
#labelOnline { color: #4ade80; font-size: 11px; }
#labelVersion { background:#d4a63a; color:#2c3e2e; padding:6px 12px; font-size:11px; border-radius:4px; }

/* NAVIGATION */
#frameNavigation { background-color:#2c3e2e; border-bottom:1px solid #1f2937; min-height:42px; }
#frameNavigation QPushButton { background:transparent; border:none; padding:8px 18px; font-size:12px; color:white; }
#frameNavigation QPushButton:checked { color:white; border-bottom:2px solid #d4a63a; font-weight:600; }

/* TITLE */
#labelSectionTitle { font-size:18px; font-weight:700; color:#000000; }

/* CARDS */
#cardAdmins,#cardOperators,#cardManagers { border-radius:8px; min-height:75px; }
#cardAdmins{background:#dbeafe;border:1px solid #bfdbfe;}
#cardOperators{background:#fffbeb;border:1px solid #fed7aa;}
#cardManagers{background:#dcfce7;border:1px solid #bbf7d0;}
#labelAdminsValue,#labelOperatorsValue,#labelManagersValue{font-size:22px;font-weight:700;color:#111827;}
#labelAdminsTitle,#labelOperatorsTitle,#labelManagersTitle{font-size:12px;color:#4b5563;}

/* ACTION BAR */
#frameActions{background:white;border:1px solid #e5e7eb;border-radius:8px;}
QLineEdit,QComboBox{padding:6px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;background:#f9fafb;}
QLineEdit:focus,QComboBox:focus{border-color:#22c55e;background:white;}
QPushButton{padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600;border:1px solid transparent;background:#e5e7eb;color:#111827;}
QPushButton:hover{background:#d1d5db;}
#btnAdd{background:#16a34a;color:white;border-color:#15803d;}
#btnAdd:hover{background:#22c55e;}
#btnExport{background:#f59e0b;color:#1f2937;border-color:#d97706;}
#btnExport:hover{background:#fbbf24;}
/* specific style for the role combo so it is clearly visible */
#comboRole{background:#2c3e2e;color:white;border:1px solid #14532d;padding:6px 18px;}
#comboRole::drop-down{border:0px;}
#comboRole QAbstractItemView{background:white;color:#111827;}

/* TABLE */
QTableView, QTableWidget{background:white;border-radius:8px;border:1px solid #e5e7eb;gridline-color:#f3f4f6;alternate-background-color:#f9fafb;}
QTableView::item, QTableWidget::item{padding:8px;}
QTableWidget::item:selected,QTableView::item:selected{background:#065f46;color:white;}
QHeaderView::section{background:#2c3e2e;color:white;padding:8px 12px;font-size:12px;border:none;}

/* STATUS BAR */
QStatusBar{background:white;border-top:1px solid #e5e7eb;font-size:11px;}
