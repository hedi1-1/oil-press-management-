  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #f5f5f5;
}

/* Header Styling */
#headerWidget {
    background-color: #1B4332;
    border-bottom: 3px solid #C9A227;
}

#lblAppTitle {
    color: white;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 2px;
}

#lblAppSubtitle {
    color: #C9A227;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 3px;
}

#lblOnlineStatus {
    color: #4CAF50;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Back Button */
#btnBackToMenu {
    background-color: #C9A227;
    color: white;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    padding: 8px 16px;
    border-radius: 4px;
    border: none;
    min-width: 80px;
}

#btnBackToMenu:hover {
    background-color: #B8911F;
}

#btnBackToMenu:pressed {
    background-color: #9A7A1A;
}

/* Tab Widget Styling */
QTabWidget::pane {
    border: 1px solid #ddd;
    background-color: white;
    border-radius: 0px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #f0f0f0;
    color: #444;
    padding: 8px 16px;
    margin-right: 2px;
    border: 1px solid #ddd;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QTabBar::tab:selected {
    background-color: white;
    color: #1B4332;
    font-weight: bold;
    border-bottom: 3px solid #1B4332;
}

QTabBar::tab:hover:!selected {
    background-color: #e8e8e8;
}

/* Group Box Styling */
QGroupBox {
    font-size: 12px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: white;
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 5px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    padding: 5px 12px;
    background-color: #1B4332;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

/* Input Field Styling */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    padding: 5px 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background-color: white;
    color: #333;
    font-size: 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-height: 16px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #1B4332;
}

/* Button Styling */
QPushButton {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-width: 90px;
    background-color: #1B4332;
    color: white;
    border: none;
}

QPushButton:hover {
    background-color: #2D5A45;
}

QPushButton:pressed {
    background-color: #0F2A1F;
}

/* Table Styling */
QTableView, QTableWidget {
    border: 1px solid #ddd;
    border-radius: 4px;
    background-color: white;
    gridline-color: #eee;
    font-size: 11px;
}

QTableView::item, QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #1B4332;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
    font-size: 11px;
}

/* Label Styling */
QLabel {
    color: #333;
    font-size: 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* ToolBar */
QToolBar {
    background-color: #f8f9fa;
    border: 1px solid #ddd;
    border-radius: 4px;
    spacing: 5px;
    padding: 5px;
}

QToolButton {
    background-color: #1B4332;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
}

QToolButton:hover {
    background-color: #2D5A45;
}

/* Frame Summary */
#frameSummary {
    background-color: #f8f9fa;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 10px;
}

#frameSummary QLabel {
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 4px;
}

#lblMachinesNormales {
    background-color: #d4edda;
    color: #155724;
}

#lblMachinesAlerte {
    background-color: #fff3cd;
    color: #856404;
}

#lblMachinesPanne {
    background-color: #f8d7da;
    color: #721c24;
}
