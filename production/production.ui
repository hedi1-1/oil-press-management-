                <property name="html">
                 <string>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd"&gt;
&lt;html&gt;&lt;head&gt;&lt;style type="text/css"&gt;
body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; background-color: #fafafa; }
h1 { color: #1B4332; border-bottom: 3px solid #C9A227; padding-bottom: 10px; }
p { color: #666; font-size: 14px; line-height: 1.8; }
&lt;/style&gt;&lt;/head&gt;&lt;body&gt;
&lt;h1&gt;📋 Rapport de Production&lt;/h1&gt;
&lt;p style="font-style: italic; color: #9ca3af;"&gt;Le rapport détaillé apparaîtra ici après génération...&lt;/p&gt;
&lt;p&gt;Cliquez sur le bouton "Générer rapport" pour créer un rapport complet incluant :&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Détails de la production&lt;/li&gt;
&lt;li&gt;Quantités et rendements&lt;/li&gt;
&lt;li&gt;Évaluation de la qualité&lt;/li&gt;
&lt;li&gt;Observations et notes&lt;/li&gt;
&lt;/ul&gt;
&lt;/body&gt;&lt;/html&gt;</string>
                </property>
