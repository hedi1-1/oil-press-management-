    <property name="styleSheet">
      <string notr="true">
QMainWindow {
    background-color: #f5f5f5;
}

/* Header Styling - now handled inline on widgets */


/* Tab Widget Styling */
QTabWidget::pane {
    border: 3px solid #1A3C2F;
    background-color: white;
    border-radius: 5px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #f0f0f0;
    color: #444;
    padding: 8px 16px;
    margin-right: 2px;
    border: 1px solid #ddd;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QTabBar::tab:selected {
    background-color: white;
    color: #1A3C2F;
    font-weight: bold;
    border-bottom: 3px solid #1A3C2F;
}

QTabBar::tab:hover:!selected {
    background-color: #e8e8e8;
}

/* Group Box Styling */
QGroupBox {
    font-size: 12px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: white;
    background-color: white;
    border: 2px solid #1A3C2F;
    border-radius: 5px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    padding: 5px 12px;
    background-color: #1B4D3E;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

/* Input Field Styling */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    padding: 5px 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background-color: white;
    color: #333;
    font-size: 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-height: 16px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #1A3C2F;
}

/* Button Styling */
QPushButton {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-width: 90px;
    background-color: #1B4D3E;
    color: white;
    border: none;
}

QPushButton:hover {
    background-color: #1A3C2F;
}

QPushButton:pressed {
    background-color: #0D3B2E;
}

/* Table Styling */
QTableView, QTableWidget {
    border: 1px solid #ddd;
    border-radius: 4px;
    background-color: white;
    gridline-color: #eee;
    font-size: 11px;
}

QTableView::item, QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #1B4D3E;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
    font-size: 11px;
}

/* Label Styling */
QLabel {
    color: #333;
    font-size: 12px;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* ToolBar */
QToolBar {
    background-color: #f8f9fa;
    border: 2px solid #1A3C2F;
    border-radius: 4px;
    spacing: 5px;
    padding: 5px;
}

QToolButton {
    background-color: #1B4D3E;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
}

QToolButton:hover {
    background-color: #1A3C2F;
}

/* Frame Summary - Modern Material Design */
#frameSummary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FAFAFA, stop:1 #F5F5F5);
    border: 2px solid #1A3C2F;
    border-radius: 12px;
    padding: 12px;
}

#frameSummary QLabel {
    font-family: 'Segoe UI', 'Roboto', Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 10px;
    border: none;
    min-height: 50px;
    letter-spacing: 0.3px;
}

#lblMachinesNormales_machine {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #E8F5E9, stop:1 #C8E6C9);
    color: #1B5E20;
    border-left: 5px solid #4CAF50;
}

#lblMachinesNormales_machine:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #C8E6C9, stop:1 #A5D6A7);
    border-left: 5px solid #388E3C;
}

#lblMachinesAlerte_machine {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFF9C4, stop:1 #FFF59D);
    color: #F57F17;
    border-left: 5px solid #FFC107;
}

#lblMachinesAlerte_machine:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFF59D, stop:1 #FFF176);
    border-left: 5px solid #FFA000;
}

#lblMachinesPanne_machine {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFEBEE, stop:1 #FFCDD2);
    color: #B71C1C;
    border-left: 5px solid #F44336;
}

#lblMachinesPanne_machine:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFCDD2, stop:1 #EF9A9A);
    border-left: 5px solid #D32F2F;
}
